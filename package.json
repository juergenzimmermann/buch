{
  "name": "buch",
  "version": "2026.10.1",
  "private": true,
  "description": "Beispiel",
  "keywords": [
    "Bun",
    "Drizzle",
    "GraphQL",
    "Hono",
    "Integrationstests",
    "JWT",
    "Keycloak",
    "Lasttests",
    "Logging",
    "Mailing",
    "OIDC",
    "ORM",
    "Oxfmt",
    "Oxlint",
    "Pino",
    "PostgreSQL",
    "REST",
    "TOML",
    "TypeScript",
    "Typedoc",
    "Unit-Tests",
    "Validierung",
    "Yoga",
    "Zod",
    "k6",
    "pnpm"
  ],
  "license": "GPL-3.0",
  "author": "Juergen Zimmermann <Juergen.Zimmermann@h-ka.de> (https://www.h-ka.de)",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env dist/src/index.mjs",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:since": "vitest --since-last-run",
    "asciidoctor": "node scripts/asciidoctor.mts",
    "dev": "node --env-file=.env --watch dist/src/index.mjs",
    "dev:ts": "node --env-file=.env --watch src/index.mts",
    "dev:bun": "bun --watch src/index.mts",
    "clean": "pnpm run clean:coverage && pnpm run clean:dist && pnpm run clean:log",
    "clean:coverage": "node --eval=\"import fs from 'node:fs/promises'; await fs.rm('coverage', { recursive: true, force: true });\"",
    "clean:dist": "node --eval=\"import fs from 'node:fs/promises'; await fs.rm('dist', { recursive: true, force: true });\"",
    "clean:log": "node --eval=\"import fs from 'node:fs/promises'; import { join } from 'node:path'; await fs.rm(join('log', 'server.log'), { force: true });\"",
    "copy-resources": "node scripts/copy-resources.mts",
    "generate-load": "node scripts/generate-load.mts",
    "hello": "node --watch src/index-hello.mts",
    "hello:bun": "bun --watch src/index-hello.mts",
    "k6": "k6 run test\\lasttest\\script.ts",
    "leasot": "leasot --exit-nicely src/**/*.mts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fmt:check:bun": "bun fmt --check",
    "sonar": "node scripts/sonar-scanner.mts",
    "tsc": "tsc --pretty",
    "tsrs": "tsrs --pretty",
    "posttsc": "pnpm run copy-resources",
    "typedoc": "typedoc src"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@prometheus-io/client": "0.16.1",
    "c12": "4.0.0-rc.4",
    "dotenv": "18.0.9",
    "drizzle-orm": "1.0.0-rc.5",
    "figlet": "1.12.0",
    "graphql": "17.1.0",
    "graphql-yoga": "6.0.1",
    "hono": "5.0.0-rc.0",
    "isbn3": "2.0.13",
    "jose": "6.2.15",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "smol-toml": "1.9.1",
    "temporal-polyfill": "1.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@asciidoctor/core": "4.2.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/node26": "26.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.4",
    "@types/k6": "2.3.1",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-istanbul": "5.1.0",
    "@vitest/ui": "5.1.0",
    "asciidoctor-kroki": "2.0.0",
    "axios": "1.21.0",
    "drizzle-kit": "1.0.0-rc.5",
    "globals": "17.14.0",
    "leasot": "14.4.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typescript": "7.1.0-beta",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@prisma/client": {
      "fast-uri": "^3.1.9"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "@prisma/prisma7": {
      "fast-uri": "^3.1.9"
    },
    "leasot": {
      "lodash": "^4.18.1"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "warn"
    },
    "runtime": [
      {
        "name": "node",
        "version": "^26.13.0",
        "onFail": "warn"
      },
      {
        "name": "bun",
        "version": "^1.4.4",
        "onFail": "warn"
      }
    ]
  },
  "engines": {
    "bun": "^1.4.4",
    "node": "^26.13.0",
    "pnpm": "^12.18.0"
  }
}
