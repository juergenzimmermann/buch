{
  "name": "buch",
  "version": "2026.10.1",
  "private": true,
  "description": "Beispiel",
  "keywords": [
    "GraphQL",
    "Hono",
    "Integrationstests",
    "JWT",
    "Keycloak",
    "Lasttests",
    "Logging",
    "Mailing",
    "OIDC",
    "ORM",
    "Oxfmt",
    "Oxlint",
    "Pino",
    "PostgreSQL",
    "Prisma",
    "REST",
    "TypeScript",
    "Typedoc",
    "Unit-Tests",
    "Validierung",
    "Yoga",
    "Zod",
    "k6",
    "pnpm"
  ],
  "license": "GPL-3.0",
  "author": "Juergen Zimmermann <Juergen.Zimmermann@h-ka.de> (https://www.h-ka.de)",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env dist/src/index.mjs",
    "test": "vitest --ui",
    "test:coverage": "vitest --ui --coverage",
    "asciidoctor": "node scripts/asciidoctor.mts",
    "dev": "node --env-file=.env --watch dist/src/index.mjs",
    "dev:ts": "node --env-file=.env --watch src/index.mts",
    "dev:bun": "bun --watch src/index.mts",
    "clean": "pnpm run clean:coverage && pnpm run clean:dist && pnpm run clean:log",
    "clean:coverage": "node --eval=\"import fs from 'node:fs/promises'; await fs.rm('coverage', { recursive: true, force: true });\"",
    "clean:dist": "node --eval=\"import fs from 'node:fs/promises'; await fs.rm('dist', { recursive: true, force: true });\"",
    "clean:log": "node --eval=\"import fs from 'node:fs/promises'; import { join } from 'node:path'; await fs.rm(join('log', 'server.log'), { force: true });\"",
    "copy-resources": "node scripts/copy-resources.mts",
    "hello": "node --watch src/index-hello.mts",
    "hello:bun": "bun --watch src/index-hello.mts",
    "k6": "k6 run test\\lasttest\\script.ts",
    "leasot": "leasot --exit-nicely src/**/*.mts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "sonar": "node scripts/sonar-scanner.mts",
    "tsc": "tsc --pretty",
    "posttsc": "pnpm run copy-resources"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/sqlcommenter-query-insights": "7.10.0",
    "@prometheus-io/client": "0.16.1",
    "dotenv": "17.4.2",
    "figlet": "1.11.4",
    "graphql": "17.0.2",
    "graphql-yoga": "5.22.0",
    "hono": "4.13.7",
    "isbn3": "2.0.11",
    "jose": "6.2.12",
    "nodemailer": "10.0.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "smol-toml": "1.8.0",
    "temporal-polyfill": "1.0.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@asciidoctor/core": "4.0.11",
    "@prisma/prisma7": "7.10.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/node26": "26.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.2",
    "@types/k6": "2.2.0",
    "@types/node": "26.5.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-istanbul": "5.0.0",
    "@vitest/ui": "5.0.0",
    "asciidoctor-kroki": "1.0.1",
    "globals": "17.12.0",
    "leasot": "14.4.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typedoc": "0.28.20",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "leasot": {
      "lodash": "4.18.1"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "warn"
    },
    "runtime": [
      {
        "name": "node",
        "version": "26.8.2",
        "onFail": "warn"
      },
      {
        "name": "bun",
        "version": "1.4.2",
        "onFail": "warn"
      }
    ]
  },
  "engines": {
    "bun": "1.4.2",
    "node": "26.8.2",
    "pnpm": "12.4.1"
  }
}
